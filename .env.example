# ============================================
# Markiq — Environment Variables
# انسخ هذا الملف وسمّه .env.local
# لا ترفع هذا الملف على GitHub أبداً
# ============================================

# ===== SUPABASE =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ===== AI APIS =====
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=sk-YOUR_KEY_HERE
RUNWAY_API_KEY=rw-YOUR_KEY_HERE

# ===== ADS PLATFORMS =====
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN

GOOGLE_ADS_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_ADS_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_DEVELOPER_TOKEN

SNAPCHAT_CLIENT_ID=YOUR_SNAP_CLIENT_ID
SNAPCHAT_CLIENT_SECRET=YOUR_SNAP_CLIENT_SECRET

TIKTOK_APP_ID=YOUR_TIKTOK_APP_ID
TIKTOK_APP_SECRET=YOUR_TIKTOK_APP_SECRET

# ===== PAYMENTS =====
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ===== APP =====
NEXT_PUBLIC_APP_URL=https://markiq.sa
NEXTAUTH_SECRET=YOUR_RANDOM_SECRET_32_CHARS
NODE_ENV=production
